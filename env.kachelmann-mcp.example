#choices: mariadb mysql postgres
#required: KACHELMANN database backend
KACHELMANN_DB_BACKEND=postgres

#required: KACHELMANN database server hostname or address
KACHELMANN_DB_URL=host.containers.internal

#default-if: KACHELMANN_DB_BACKEND=mariadb 3306
#default-if: KACHELMANN_DB_BACKEND=mysql 3306
#required: KACHELMANN database server port
KACHELMANN_DB_PORT=5432

#required: KACHELMANN database name
KACHELMANN_DB_NAME=kachelmann

#required: KACHELMANN database user
KACHELMANN_DB_USER=kachelmann

#required: KACHELMANN database password
#secret
KACHELMANN_DB_PW=

#optional: KACHELMANN database table prefix; blank uses unprefixed tables
KACHELMANN_DB_PREFIX=blank

#default-preset: /var/lib/kachelmann/content
#required: Shared KACHELMANN content directory used by Fedora and this sidecar
KACHELMANN_CONTENT_PATH=/var/lib/kachelmann/content

#default-preset: 10001
#required: Shared group used for KACHELMANN content directories and files
KACHELMANN_CONTENT_GID=10001

#required: Shared Bearer credential for the KACHELMANN MCP server
#secret
KACHELMANN_EDITOR_TOKEN=example: openssl rand -hex 32

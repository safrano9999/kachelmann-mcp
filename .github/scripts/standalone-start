#!/usr/bin/bash
set -eu
children=()
stop_children() {
    trap - EXIT INT TERM
    if (( ${#children[@]} )); then
        kill "${children[@]}" 2>/dev/null || true
        wait || true
    fi
}
trap stop_children EXIT
trap 'exit 0' TERM INT
python -m uvicorn webui:app --host "$FASTAPI_HOST" --port "$KACHELMANN_PORT" &
children+=("$!")
if [[ "${KACHELMANN_MCP_ENABLED,,}" == true ]]; then
    python -m kachelmann.mcp_server --transport streamable-http &
    children+=("$!")
fi
wait -n
exit 1

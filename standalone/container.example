#default-preset: TUN
CONTAINER_NR=TUN
#default-preset: 127.0.0.1
KACHELMANN_PUBLISH_HOST=127.0.0.1
#default-preset: 8080
KACHELMANN_PUBLISH_PORT=8080
#default-preset: 127.0.0.1
KACHELMANN_MCP_PUBLISH_HOST=127.0.0.1
#default-preset: 8000
KACHELMANN_MCP_PUBLISH_PORT=8000

#repeat-group: ADDITIONAL_LINE suffix02 ADDITIONAL_LINE
#repeat-freeform: ADDITIONAL_LINE
ADDITIONAL_LINE=Network=rafael
ADDITIONAL_LINE_02=NoNewPrivileges=true
ADDITIONAL_LINE_03=Pull=never

# Source of truth: SCRIPTS/githubactions. Generated copies are overwritten.
FROM registry.fedoraproject.org/fedora:latest

RUN dnf -y --setopt=install_weak_deps=False install python3.14 python3.14-devel gcc libpq-devel shadow-utils \
    && dnf clean all && python3.14 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    FASTAPI_HOST=0.0.0.0 KACHELMANN_PORT=8080 \
    KACHELMANN_MCP_ENABLED=true KACHELMANN_MCP_HOST=0.0.0.0 KACHELMANN_MCP_PORT=8000
WORKDIR /opt/kachelmann
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt && pip check
COPY python_header.py config.json webui.py KACHELMANN_SOT.md prompt.md package.json release.json kachelmann-*.apk ./
COPY kachelmann ./kachelmann
COPY COACHING_ADVISES ./COACHING_ADVISES
COPY static ./static
COPY templates ./templates
COPY standalone-start /usr/local/bin/standalone-start
RUN useradd -m -u 10001 kachelmann && install -d -o kachelmann -g kachelmann sqlite
USER kachelmann
EXPOSE 8080 8000
ENTRYPOINT ["/usr/local/bin/standalone-start"]
